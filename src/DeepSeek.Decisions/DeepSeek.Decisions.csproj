<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>Yue Zhishun</Authors>
    <Description>基于 DeepSeek API 的 Jev 和 Decisions 强类型决策客户端。</Description>
    <PackageReleaseNotes>Adds OpenAI Decisions and Jev System One JSON protocol entry points, including Jev box confidence.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/yuezhishun/decisions-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yuezhishun/decisions-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>LLM,AI,DeepSeek,Jev,Decisions,Classification,.NETStandard</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Version>1.2.0</Version>
    <PackageId>DeepSeek.Decisions</PackageId>
    <AssemblyName>DeepSeek.Decisions</AssemblyName>
    <RootNamespace>DeepSeek.Decisions</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>./pack</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DeepSeek.Core" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\logo.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
